{
  auto_https off
  admin off
}

:8080 {
  @private path /internal/* /api/internal/*
  respond @private 404
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }
  handle /api/v1/catalog/* {
    reverse_proxy catalog:8000
  }
  @identity path /api/v1/auth/* /api/v1/admin/auth/* /api/v1/me /api/v1/me/* /.well-known/jwks.json
  handle @identity {
    reverse_proxy identity:8000 {
      header_up X-Nivaro-Client-IP {remote_host}
    }
  }
  handle {
    reverse_proxy web:3000
  }
}
