{
  auto_https off
  admin off
}

:8080 {
  @private path /internal /internal/* /api/internal /api/internal/*
  handle @private {
    respond 404
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }
  handle /api/v1/catalog/* {
    reverse_proxy catalog:8000
  }
  handle /api/v1/admin/catalog/* {
    request_body {
      max_size 8388608
    }
    reverse_proxy catalog:8000
  }
  @identity path /api/v1/auth/* /api/v1/admin/auth/* /api/v1/admin/me /api/v1/admin/me/* /api/v1/me /api/v1/me/* /.well-known/jwks.json
  handle @identity {
    request_body {
      max_size 8388608
    }
    reverse_proxy identity:8000 {
      header_up X-Nivaro-Client-IP {remote_host}
    }
  }
  @cart path /api/v1/cart /api/v1/cart/* /api/v1/builds /api/v1/builds/*
  handle @cart {
    reverse_proxy cart:8000
  }
  handle /api/v1/orders/* {
    reverse_proxy orders:8000
  }
  handle /api/v1/admin/orders/* {
    reverse_proxy orders:8000
  }
  @support path /api/v1/support/* /api/v1/admin/support/*
  handle @support {
    reverse_proxy support:8000
  }
  handle {
    reverse_proxy {$NIVARO_WEB_UPSTREAM:web:3000}
  }
}
