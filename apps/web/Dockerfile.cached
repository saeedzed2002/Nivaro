# Local recovery path: reuse a previously verified Linux dependency store.
# This is not a cold offline bootstrap. Missing packages have one bounded attempt.
ARG CACHE_IMAGE=nivaro-web:development
ARG NODE_IMAGE=node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
FROM ${CACHE_IMAGE} AS builder
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prefer-offline --fetch-timeout=20000 --fetch-retries=0
COPY . .
RUN pnpm build
FROM ${NODE_IMAGE} AS release
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
