{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DeliveredProducts": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "format": "uuid",
          "title": "Customer Id",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "customer_id",
        "product_ids"
      ],
      "title": "DeliveredProducts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "order.delivered",
      "title": "Event Type",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "producer": {
      "const": "orders",
      "title": "Producer",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "aggregate_id": {
      "format": "uuid",
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_version": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Aggregate Version",
      "type": "integer"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Causation Id"
    },
    "payload": {
      "$ref": "#/$defs/DeliveredProducts"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "producer",
    "occurred_at",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "causation_id",
    "payload"
  ],
  "title": "OrderDelivered",
  "type": "object"
}
