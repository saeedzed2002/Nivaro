{
  "components": {
    "schemas": {
      "CheckoutIntent": {
        "additionalProperties": false,
        "properties": {
          "address_id": {
            "format": "uuid",
            "title": "Address Id",
            "type": "string"
          },
          "address_version": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Address Version",
            "type": "integer"
          },
          "cart_version": {
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Cart Version",
            "type": "integer"
          },
          "coupon_code": {
            "anyOf": [
              {
                "pattern": "^[A-Z0-9][A-Z0-9_-]{0,39}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coupon Code"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "market": {
            "$ref": "#/components/schemas/Market"
          }
        },
        "required": [
          "market",
          "currency",
          "cart_version",
          "address_id",
          "address_version"
        ],
        "title": "CheckoutIntent",
        "type": "object"
      },
      "ConfirmPreview": {
        "additionalProperties": false,
        "properties": {
          "confirmation": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Confirmation",
            "type": "string"
          }
        },
        "required": [
          "confirmation"
        ],
        "title": "ConfirmPreview",
        "type": "object"
      },
      "Currency": {
        "enum": [
          "IRR",
          "USD"
        ],
        "type": "string"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Market": {
        "enum": [
          "ir",
          "international"
        ],
        "type": "string"
      },
      "OrderStatus": {
        "additionalProperties": false,
        "properties": {
          "failure_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Code"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "reservation_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reservation Expires At"
          },
          "status": {
            "enum": [
              "pending_reservation",
              "awaiting_payment",
              "expired",
              "cancelled",
              "payment_processing",
              "payment_review",
              "paid",
              "refund_pending",
              "refunded"
            ],
            "title": "Status",
            "type": "string"
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "status",
          "version",
          "totals",
          "reservation_expires_at",
          "failure_code"
        ],
        "title": "OrderStatus",
        "type": "object"
      },
      "PreviewResponse": {
        "additionalProperties": false,
        "properties": {
          "confirmation": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Confirmation",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/ReviewGroup"
            },
            "title": "Groups",
            "type": "array"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/ReviewLine"
            },
            "title": "Lines",
            "type": "array"
          },
          "operation_id": {
            "format": "uuid",
            "title": "Operation Id",
            "type": "string"
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          }
        },
        "required": [
          "operation_id",
          "confirmation",
          "expires_at",
          "totals",
          "lines",
          "groups"
        ],
        "title": "PreviewResponse",
        "type": "object"
      },
      "ReviewGroup": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "complete_build",
              "parts_only"
            ],
            "title": "Mode",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "compatible",
              "incompatible",
              "needs_review",
              "incomplete"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "mode",
          "status"
        ],
        "title": "ReviewGroup",
        "type": "object"
      },
      "ReviewLine": {
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Group Id"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "unit_price_minor": {
            "title": "Unit Price Minor",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "group_id",
          "name",
          "quantity",
          "unit_price_minor"
        ],
        "title": "ReviewLine",
        "type": "object"
      },
      "Totals": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "discount_minor": {
            "maximum": 9000000000000000.0,
            "minimum": 0.0,
            "title": "Discount Minor",
            "type": "integer"
          },
          "market": {
            "$ref": "#/components/schemas/Market"
          },
          "shipping_minor": {
            "maximum": 9000000000000000.0,
            "minimum": 0.0,
            "title": "Shipping Minor",
            "type": "integer"
          },
          "subtotal_minor": {
            "maximum": 9000000000000000.0,
            "minimum": 0.0,
            "title": "Subtotal Minor",
            "type": "integer"
          },
          "tax_included": {
            "title": "Tax Included",
            "type": "boolean"
          },
          "tax_minor": {
            "maximum": 9000000000000000.0,
            "minimum": 0.0,
            "title": "Tax Minor",
            "type": "integer"
          },
          "total_minor": {
            "maximum": 9000000000000000.0,
            "minimum": 0.0,
            "title": "Total Minor",
            "type": "integer"
          }
        },
        "required": [
          "market",
          "currency",
          "subtotal_minor",
          "discount_minor",
          "shipping_minor",
          "tax_minor",
          "tax_included",
          "total_minor"
        ],
        "title": "Totals",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Nivaro Orders",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/orders/checkout/preview": {
      "post": {
        "operationId": "previewCheckout",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutIntent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Preview",
        "tags": [
          "orders"
        ]
      }
    },
    "/api/v1/orders/checkout/{operation_id}/confirm": {
      "post": {
        "operationId": "confirmCheckout",
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Operation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmPreview"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Confirm",
        "tags": [
          "orders"
        ]
      }
    },
    "/api/v1/orders/{order_id}": {
      "get": {
        "operationId": "readOrderStatus",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Order Status",
        "tags": [
          "orders"
        ]
      }
    }
  }
}
