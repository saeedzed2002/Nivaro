            "type": "string"
          },
          "last_sequence": {
            "title": "Last Sequence",
            "type": "integer"
          },
          "status": {
            "enum": [
              "open",
              "waiting",
              "closed"
            ],
            "title": "Status",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "subject",
          "status",
          "assigned_agent_id",
          "version",
          "last_sequence",
          "created_at",
          "closed_at"
        ],
        "title": "Conversation",
        "type": "object"
      },
      "ConversationPage": {
        "additionalProperties": false,
